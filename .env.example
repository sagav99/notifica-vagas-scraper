# Serper (google.serper.dev) — resultado real do Google, sem precisar de
# Google Cloud Console/faturamento. Chave: serper.dev > Dashboard > API Key.
SERPER_API_KEY=

# Chave Gemini dedicada exclusivamente à extração desta fonte.
GEMINI_API_KEY_DESCOBERTA_GOOGLE=

# Mesmos valores do `.env.local` do repo principal (notifica-vagas) —
# usados só pra subir o print da página do PDF no bucket `evidencias-pdf`
# (migration 017). Rodando local, já vêm de `source .env.local` do repo
# principal antes de chamar os scripts daqui, ver TAREFAS.md.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
